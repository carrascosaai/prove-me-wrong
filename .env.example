# ─────────────────────────────────────────────────────────────
# PROVE ME WRONG — environment variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Optional on Vercel — it is
# derived from VERCEL_PROJECT_PRODUCTION_URL automatically. Set it
# only to pin a custom domain.
NEXT_PUBLIC_SITE_URL=

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Ads (optional, leave blank until you have traffic) ───────
# Google AdSense publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Moderation (optional) ───────────────────────────────────
ADMIN_SECRET=
