# ─────────────────────────────────────────────────────────────
# PROVE ME WRONG — environment variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for share links + OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Payments (Stripe) ───────────────────────────────────────
# Master switch. When false, the app shows a simulated checkout
# and never contacts Stripe.
PAYMENTS_ENABLED=false

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price for "PRO PREDICTION". Create a one-time Price in Stripe (EUR 2.99)
# and paste its price_id here, OR leave blank to use an inline price.
STRIPE_PRICE_PRO=

# ── Ads (optional, leave blank until you have traffic) ───────
# Google AdSense publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Moderation (optional) ───────────────────────────────────
# Comma-separated list of admin manage tokens allowed to feature/
# mark predictions as sponsored from the manage page.
ADMIN_SECRET=
